# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_publishable_key

# Tenant Configuration
# Keep the browser and server slugs aligned with an active tenant row.
NEXT_PUBLIC_TENANT_SLUG=reviewworks
CANONICAL_TENANT_SLUG=reviewworks

# Server-only Supabase secret key (sb_secret_...). Every write goes through the API
# routes using this key; the browser never writes to PostgREST directly.
# Create it in Project Settings > API Keys > Secret keys. Never expose it to the client.
SUPABASE_SECRET_KEY=sb_secret_your_secret_key

# HedgeDoc Configuration (optional - if not set, uses internal markdown editor)
HEDGEDOC_BASE_URL=
HEDGEDOC_API_TOKEN=

# Application URL (for redirects)
NEXT_PUBLIC_APP_BASE_URL=http://localhost:3000
